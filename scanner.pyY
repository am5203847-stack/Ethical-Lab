cat > ~/Ethical-Lab/scanner.py << 'EOF'
import socket
print("=== ADEL Ethical Scanner V1 ===")
target = input("اكتب IP بتاعك 127.0.0.1 : ")
for port in [21,22,80,443,8080]:
    s = socket.socket()
    s.settimeout(1)
    try:
        s.connect((target, port))
        print(f"[OPEN] Port {port} مفتوح")
    except:
        print(f"[CLOSED] Port {port} مقفول")
    s.close()
EOF

